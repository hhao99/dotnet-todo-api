@todoapi_HostAddress = http://localhost:5220/api/v1.0
@id = 1
### get all todos
GET {{todoapi_HostAddress}}/todos
Accept: application/json

### get completed todos 
GET {{todoapi_HostAddress}}/todos/completed
Accept: application/json
###
GET {{todoapi_HostAddress}}/todos/{{id}}
Accept: application/json

### 
POST {{todoapi_HostAddress}}/todos
Content-Type: application/json

{
  "Task": "New Todo",
  "Completed": true
}

###
PUT {{todoapi_HostAddress}}/todos/{{id}}
Content-Type: application/json

{
  "Task": "Updated Todo",
  "Completed": true
}

###
DELETE {{todoapi_HostAddress}}/todos/{{id}}
